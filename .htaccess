RewriteRule ^/en/terms/?$ https://www.beraterium.com/terms/ [R=301,L,NC]
RewriteRule ^/de/team/?$ /team/ [R=301,L,NC]
RewriteRule ^/de/blog/?$ /blog/ [R=301,L,NC]
RewriteRule ^/en/team/?$ https://www.beraterium.com/team/ [R=301,L,NC]
RewriteRule ^/en/blog/?$ https://www.beraterium.com/blog/ [R=301,L,NC]
RewriteRule ^/de/agb/?$ /agb/ [R=301,L,NC]
RewriteRule ^/de/404/?$ /404/ [R=301,L,NC]
RewriteRule ^/en/404/?$ https://www.beraterium.com/404/ [R=301,L,NC]
RewriteRule ^/de/gtc/?$ /agb/ [R=301,L,NC]
RewriteRule ^/de/?$ / [R=301,L,NC]
RewriteRule ^/en/?$ https://www.beraterium.com/ [R=301,L,NC]

# Fallback: strip /de/ prefix for unmapped legacy paths
RewriteRule ^de/(.*)$ /$1/ [R=301,L]
